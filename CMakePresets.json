{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_PREFIX_PATH": "$env{QT_PREFIX}" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x86_64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_INSTALL_PREFIX": "${sourceDir}/AppDir/usr" }
    }
  ],
  "buildPresets": [
    { "name": "macos-release", "configurePreset": "macos-release", "jobs": 4 },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "linux-release", "configurePreset": "linux-release", "jobs": 4 }
  ]
}
